# 環境設定
ENVIRONMENT=development

# =====================================
# Firestore設定
# =====================================
FIRESTORE_CREDENTIALS_PATH=firestore-key.json

# =====================================
# ローカル開発用データベース設定（旧設定・移行後削除予定）
# =====================================
# DATABASE_URL=postgresql://postgres:password@localhost:5432/mealmind

# =====================================
# Cloud SQL接続設定（旧設定・移行後削除予定）
# =====================================
# Cloud SQL Proxyを使用する場合
# CLOUD_SQL_CONNECTION_NAME=your-project:asia-northeast1:mealmind-db
# DB_USER=dbuser
# DB_PASSWORD=your-db-password
# DB_NAME=mealmind

# =====================================
# Google Cloud Platform
# =====================================
GCP_PROJECT_ID=your-gcp-project-id

# =====================================
# Google OAuth 2.0
# =====================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# =====================================
# JWT設定
# =====================================
# 以下のコマンドで生成: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-generate-with-openssl
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# セッション管理（CSRF対策用）
# 以下のコマンドで生成: openssl rand -hex 32
SESSION_SECRET_KEY=your-session-secret-key-here-generate-with-openssl

# =====================================
# Google Gemini API
# =====================================
# https://aistudio.google.com/app/apikey で取得
GEMINI_API_KEY=your-gemini-api-key

# =====================================
# CORS設定
# =====================================
# フロントエンドのURL(カンマ区切りで複数指定可能)
FRONTEND_URL=http://localhost:3000

# =====================================
# Cloud Storage (オプション)
# =====================================
GCS_BUCKET_NAME=your-bucket-name

# =====================================
# アプリケーション設定
# =====================================
# サーバーポート (Cloud Runでは8080)
PORT=8000

# ログレベル
LOG_LEVEL=info
