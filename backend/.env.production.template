# 環境設定
ENVIRONMENT=production

# =====================================
# Cloud SQL接続設定
# =====================================
# setup-cloud-sql.sh実行後に表示される値を設定
CLOUD_SQL_CONNECTION_NAME=your-project:asia-northeast1:mealmind-db
DB_USER=dbuser
DB_PASSWORD=your-db-password
DB_NAME=mealmind

# =====================================
# Google Cloud Platform
# =====================================
GCP_PROJECT_ID=your-gcp-project-id

# =====================================
# JWT設定
# =====================================
# 本番環境用に新しい秘密鍵を生成: openssl rand -hex 32
SECRET_KEY=your-production-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# セッション管理（CSRF対策用）
# 以下のコマンドで生成: openssl rand -hex 32
SESSION_SECRET_KEY=your-production-session-secret-key

# =====================================
# Google Gemini API
# =====================================
GEMINI_API_KEY=your-gemini-api-key

# =====================================
# CORS設定
# =====================================
# フロントエンドのCloud Run URL（deploy-frontend.sh実行後に更新）
FRONTEND_URL=https://mealmind-frontend-xxxxx-an.a.run.app

# =====================================
# Google OAuth 2.0
# =====================================
# Google Cloud Consoleで本番環境用のOAuth認証情報を作成
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# フロントエンドのURLに更新
GOOGLE_REDIRECT_URI=https://mealmind-frontend-xxxxx-an.a.run.app/auth/google/callback

# =====================================
# アプリケーション設定
# =====================================
PORT=8080
LOG_LEVEL=info
